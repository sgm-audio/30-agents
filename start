#!/usr/bin/env bash
# ============================================================
# start — One-command ready: venv + Redis + API server
# Usage:
#   ./start              # ensure deps/services, start API in background
#   ./start --fg         # start API in foreground
#   ./start --status     # print health only
#   ./start --stop       # stop background API
# ============================================================
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$ROOT/venv"
PYTHON="$VENV/bin/python"
PID_FILE="$ROOT/logs/server.pid"
LOG_FILE="$ROOT/logs/server.log"
API_URL="${AGENTS30_API_BASE:-http://127.0.0.1:8000}"
SESSION="${AGENTS30_TMUX_SESSION:-agents30}"

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; NC='\033[0m'
info()  { echo -e "${GREEN}[ok]${NC}  $*"; }
warn()  { echo -e "${YELLOW}[..]${NC}  $*"; }
error() { echo -e "${RED}[!]${NC}  $*"; }

ensure_dirs() {
  mkdir -p "$ROOT/logs" "$ROOT/data/chroma"
}

ensure_venv() {
  if [[ ! -x "$PYTHON" ]]; then
    warn "Creating virtualenv..."
    python3 -m venv "$VENV"
  fi
  if ! "$PYTHON" -c "import fastapi, uvicorn, typer" >/dev/null 2>&1; then
    warn "Installing Python dependencies..."
    "$VENV/bin/pip" install -U pip -q
    "$VENV/bin/pip" install -r "$ROOT/requirements.txt" -q
  fi
  info "Python: $("$PYTHON" -c 'import sys; print(sys.executable)')"
}

ensure_redis() {
  if redis-cli ping >/dev/null 2>&1; then
    info "Redis: up"
    return 0
  fi

  warn "Starting Redis..."
  if command -v redis-server >/dev/null 2>&1; then
    if command -v service >/dev/null 2>&1; then
      sudo service redis-server start >/dev/null 2>&1 || true
    fi
    if ! redis-cli ping >/dev/null 2>&1; then
      redis-server --daemonize yes --port 6379 >/dev/null 2>&1 || true
    fi
  elif command -v docker >/dev/null 2>&1; then
    docker start redis-agent >/dev/null 2>&1 || \
      docker run -d --name redis-agent --restart unless-stopped -p 6379:6379 redis:7-alpine >/dev/null
  elif command -v podman >/dev/null 2>&1; then
    podman start redis-agent >/dev/null 2>&1 || \
      podman run -d --name redis-agent --restart always -p 6379:6379 docker.io/library/redis:7-alpine >/dev/null
  else
    error "Redis not available (install redis-server, docker, or podman)"
    return 1
  fi

  for _ in 1 2 3 4 5; do
    if redis-cli ping >/dev/null 2>&1; then
      info "Redis: up"
      return 0
    fi
    sleep 1
  done
  error "Redis failed to start"
  return 1
}

api_healthy() {
  curl -sf --max-time 2 "$API_URL/api/health" >/dev/null 2>&1
}

print_status() {
  if api_healthy; then
    local body
    body="$(curl -sf --max-time 3 "$API_URL/api/health" || true)"
    info "API:   $API_URL  ($body)"
  else
    warn "API:   not running"
  fi
  if redis-cli ping >/dev/null 2>&1; then
    info "Redis: PONG"
  else
    warn "Redis: down"
  fi
  if [[ -x "$PYTHON" ]]; then
    info "venv:  ready  (python → $PYTHON)"
  else
    warn "venv:  missing"
  fi
}

stop_server() {
  if [[ -f "$PID_FILE" ]]; then
    local pid
    pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [[ -n "${pid:-}" ]] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
      sleep 1
      kill -9 "$pid" 2>/dev/null || true
      info "Stopped API (pid $pid)"
    fi
    rm -f "$PID_FILE"
  fi
  # Also try tmux session used by run.sh / cloud agent
  if command -v tmux >/dev/null 2>&1; then
    tmux kill-session -t "$SESSION" 2>/dev/null || true
    tmux -f /exec-daemon/tmux.portal.conf kill-session -t "agents30-serve" 2>/dev/null || true
  fi
  # Fallback: anything bound to :8000 from this project
  if command -v fuser >/dev/null 2>&1; then
    fuser -k 8000/tcp >/dev/null 2>&1 || true
  fi
}

start_foreground() {
  ensure_dirs
  ensure_venv
  ensure_redis
  cd "$ROOT"
  info "Starting API in foreground on http://0.0.0.0:8000 ..."
  exec "$PYTHON" main.py serve
}

start_background() {
  ensure_dirs
  ensure_venv
  ensure_redis

  if api_healthy; then
    info "API already running"
    print_status
    echo ""
    echo "Ready. Try:"
    echo "  python main.py health"
    echo "  python main.py chat \"hello\""
    echo "  open $API_URL"
    return 0
  fi

  stop_server >/dev/null 2>&1 || true
  cd "$ROOT"
  nohup "$PYTHON" main.py serve >>"$LOG_FILE" 2>&1 &
  echo $! >"$PID_FILE"
  warn "Starting API (pid $(cat "$PID_FILE"))..."

  for _ in $(seq 1 40); do
    if api_healthy; then
      info "API ready at $API_URL"
      print_status
      echo ""
      echo "Ready whenever you are:"
      echo "  python main.py health"
      echo "  python main.py chat \"hello\""
      echo "  curl $API_URL/api/health"
      echo "  ./start --stop     # stop later"
      return 0
    fi
    sleep 1
  done

  error "API did not become healthy. Last log lines:"
  tail -n 40 "$LOG_FILE" || true
  return 1
}

case "${1:-}" in
  --status|-s) ensure_dirs; print_status ;;
  --stop)      stop_server; print_status ;;
  --fg|--foreground) start_foreground ;;
  ""|--bg|--background) start_background ;;
  -h|--help)
    sed -n '2,10p' "$0"
    ;;
  *)
    error "Unknown option: $1 (try --help)"
    exit 2
    ;;
esac
