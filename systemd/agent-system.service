[Unit]
Description=30-Agent Cognitive System API Server
After=ollama.service redis-agent.service
Requires=ollama.service

[Service]
Type=simple
# Update this path to your checkout before installing the unit.
WorkingDirectory=/opt/30-agents
ExecStart=/opt/30-agents/venv/bin/python main.py serve
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
